# DiviTrack yapılandırması — bu dosyayı .env olarak kopyalayın
DIVITRACK_DB_PATH=data/divitrack.db
DIVITRACK_BASE_CURRENCY=TRY          # Varsayılan raporlama para birimi: TRY | USD | EUR
DIVITRACK_PRICE_CACHE_TTL_MIN=15     # Fiyat önbelleği süresi (dakika)
DIVITRACK_OFFLINE=0                  # 1 = internetten hiç veri çekme (yalnızca önbellek/manuel fiyat)
DIVITRACK_LOG_LEVEL=INFO
